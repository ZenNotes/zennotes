{
  "name": "@zennotes/web",
  "private": true,
  "version": "2.84.0",
  "type": "module",
  "description": "ZenNotes web client for self-hosted and hosted deployments",
  "homepage": "https://zennotes.org",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --config vite.cloud.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "build:cloud": "tsc --noEmit && vite build --config vite.cloud.config.ts",
    "preview": "vite preview",
    "preview:cloud": "vite preview --config vite.cloud.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.3",
